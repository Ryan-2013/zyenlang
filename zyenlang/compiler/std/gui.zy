public class Application {
    private title: str = "ZyenLang"
    private width: i32 = 800
    private height: i32 = 600
    private background: str = "#20201F"
    public fps: i32 = 60
    private opened: bool = false

    public init(title: str, width: i32, height: i32, background: str = "#20201F") {
        this.title = title
        this.width = width
        this.height = height
        this.background = background
    }

    deinit {
        if this.opened {
            session_close()
        }
    }

    public mut fn open() i32 {
        if this.opened {
            return -1
        }
        let result = session_open(this.title, this.width, this.height, "")
        if result == 0 {
            session_set_fps(this.fps)
            this.opened = true
        }
        return result
    }

    public fn begin_frame() i32 {
        if !this.opened {
            return -1
        }
        let result = session_begin_frame()
        if result == 0 {
            draw_background(this.background)
        }
        return result
    }

    public fn present() i32 {
        if !this.opened {
            return -1
        }
        return session_redraw()
    }

    public fn next_event(timeout_ms: i32) str {
        if !this.opened {
            return ""
        }
        return session_next_event(timeout_ms)
    }

    public mut fn close() i32 {
        if !this.opened {
            return 0
        }
        let result = session_close()
        this.opened = false
        return result
    }

    public fn panel(x: i32, y: i32, width: i32, height: i32) Panel {
        return Panel(this, x, y, width, height)
    }

    public fn label(x: i32, y: i32, value: str) Label {
        return Label(this, x, y, value)
    }

    public fn button(x: i32, y: i32, width: i32, height: i32, label: str, on_click: fn() void) Button {
        return Button(this, x, y, width, height, label, on_click)
    }

    public fn button_group() ButtonGroup {
        return ButtonGroup(this)
    }

    public fn column(x: i32, y: i32, width: i32, row_height: i32, gap: i32) Column {
        return Column(this, x, y, width, row_height, gap)
    }

    public fn pick_file() i32 {
        if !this.opened {
            return -1
        }
        return session_pick_file()
    }

    public fn line(x1: i32, y1: i32, x2: i32, y2: i32, color: str, width: i32) i32 {
        if !this.opened {
            return -1
        }
        return draw_line_native(x1, y1, x2, y2, color, width)
    }

    public fn rect(x: i32, y: i32, width: i32, height: i32, color: str) i32 {
        if !this.opened {
            return -1
        }
        return draw_rect_native(x, y, width, height, color)
    }

    public fn circle(x: i32, y: i32, radius: i32, color: str) i32 {
        if !this.opened {
            return -1
        }
        return draw_circle_native(x, y, radius, color)
    }

    public fn text(x: i32, y: i32, value: str, color: str, size: i32) i32 {
        if !this.opened {
            return -1
        }
        return draw_text_native(x, y, value, color, size)
    }

    public fn code_view(x: i32, y: i32, width: i32, height: i32, first_line: i32, line_height: i32, char_width: i32, size: i32, stamp: i32, lines: str) i32 {
        if !this.opened {
            return -1
        }
        return draw_code_view_native(x, y, width, height, first_line, line_height, char_width, size, stamp, lines)
    }

    public fn code_editor(x: i32, y: i32, width: i32, height: i32, first_line: i32, line_height: i32, char_width: i32, size: i32, stamp: i32, lines: str, selection_start_line: i32, selection_start_column: i32, selection_end_line: i32, selection_end_column: i32) i32 {
        if !this.opened {
            return -1
        }
        return draw_code_editor_native(x, y, width, height, first_line, line_height, char_width, size, stamp, lines, selection_start_line, selection_start_column, selection_end_line, selection_end_column)
    }

    public fn completion(x: i32, y: i32, width: i32, row_height: i32, size: i32, selected: i32, items: str) i32 {
        if !this.opened {
            return -1
        }
        return draw_completion_native(x, y, width, row_height, size, selected, items)
    }

    public fn event_kind(event: str) i32 {
        return event_kind_native(event)
    }

    public fn event_x(event: str) i32 {
        return event_x_native(event)
    }

    public fn event_y(event: str) i32 {
        return event_y_native(event)
    }
}

public class Panel {
    private app: Application
    public x: i32 = 0
    public y: i32 = 0
    public width: i32 = 320
    public height: i32 = 240
    public background: str = "#292827"
    public border: str = "#494744"

    public init(app: Application, x: i32, y: i32, width: i32, height: i32) {
        this.app = app
        this.x = x
        this.y = y
        this.width = width
        this.height = height
    }

    public fn draw() i32 {
        let border_result = this.app.rect(this.x, this.y, this.width, this.height, this.border)
        if border_result != 0 {
            return border_result
        }
        return this.app.rect(this.x + 1, this.y + 1, this.width - 2, this.height - 2, this.background)
    }
}

public class Label {
    private app: Application
    public x: i32 = 0
    public y: i32 = 0
    public value: str = ""
    public color: str = "#F4F1EA"
    public size: i32 = 18

    public init(app: Application, x: i32, y: i32, value: str) {
        this.app = app
        this.x = x
        this.y = y
        this.value = value
    }

    public fn draw() i32 {
        return this.app.text(this.x, this.y, this.value, this.color, this.size)
    }
}

public class Button {
    private app: Application
    public x: i32 = 0
    public y: i32 = 0
    public width: i32 = 180
    public height: i32 = 44
    public label: str = "Button"
    public background: str = "#D97757"
    public disabled_background: str = "#6E6965"
    public text_color: str = "#20201F"
    public border: str = "#F0A084"
    public font_size: i32 = 18
    public enabled: bool = true
    public on_click: fn() void

    public init(app: Application, x: i32, y: i32, width: i32, height: i32, label: str, on_click: fn() void) {
        this.app = app
        this.x = x
        this.y = y
        this.width = width
        this.height = height
        this.label = label
        this.on_click = on_click
    }

    public fn contains(x: i32, y: i32) bool {
        return x >= this.x && x < this.x + this.width && y >= this.y && y < this.y + this.height
    }

    public fn draw() i32 {
        let fill = this.background
        if !this.enabled {
            fill = this.disabled_background
        }
        let border_result = this.app.rect(this.x, this.y, this.width, this.height, this.border)
        if border_result != 0 {
            return border_result
        }
        let fill_result = this.app.rect(this.x + 1, this.y + 1, this.width - 2, this.height - 2, fill)
        if fill_result != 0 {
            return fill_result
        }
        return this.app.text(this.x + 14, this.y + (this.height - this.font_size) / 2, this.label, this.text_color, this.font_size)
    }

    public fn handle(event: str) bool {
        if this.enabled && this.app.event_kind(event) == 2 && this.contains(this.app.event_x(event), this.app.event_y(event)) {
            this.on_click()
            return true
        }
        return false
    }
}

public class ButtonGroup {
    private app: Application
    public buttons: List<Button> = []

    public init(app: Application) {
        this.app = app
    }

    public mut fn add(button_value: Button) void {
        LIST_PUSH__(this.buttons, button_value)
    }

    public fn draw() i32 throws Error {
        let index: i32 = 0
        while index < (i32)LIST_LEN__(this.buttons) {
            let button_value = LIST_GET__(this.buttons, index)
            let result = button_value.draw()
            if result != 0 {
                return result
            }
            index += 1
        }
        return 0
    }

    public fn handle(event: str) bool throws Error {
        let index: i32 = 0
        let handled = false
        while index < (i32)LIST_LEN__(this.buttons) {
            let button_value = LIST_GET__(this.buttons, index)
            if button_value.handle(event) {
                handled = true
            }
            index += 1
        }
        return handled
    }
}

public class Column {
    private app: Application
    public x: i32 = 0
    public y: i32 = 0
    public width: i32 = 240
    public row_height: i32 = 44
    public gap: i32 = 10

    public init(app: Application, x: i32, y: i32, width: i32, row_height: i32, gap: i32) {
        this.app = app
        this.x = x
        this.y = y
        this.width = width
        this.row_height = row_height
        this.gap = gap
    }

    public fn item_y(index: i32) i32 {
        return this.y + index * (this.row_height + this.gap)
    }

    public fn button_at(index: i32, label_value: str, on_click: fn() void) Button {
        return Button(this.app, this.x, this.item_y(index), this.width, this.row_height, label_value, on_click)
    }

    public fn label_at(index: i32, value: str) Label {
        return Label(this.app, this.x, this.item_y(index) + (this.row_height - 18) / 2, value)
    }
}

public fn application(title: str, width: i32, height: i32) Application {
    return Application(title, width, height)
}

public fn application_colored(title: str, width: i32, height: i32, background: str) Application {
    return Application(title, width, height, background)
}

public fn event_kind(event: str) i32 {
    return event_kind_native(event)
}

public fn event_x(event: str) i32 {
    return event_x_native(event)
}

public fn event_y(event: str) i32 {
    return event_y_native(event)
}
