fn main() -> int {
    let list: List = List;

    list.append(1);
    list.append("hello");
    list.append(true);

    print((str)(list));
    print((str)(list.len()));
    print((str)(list.is_empty()));
    print((str)(list.get(0)));
    print((str)(list.get(1)));
    print((str)(list.get(2)));

    list.set(0, 99);
    print((str)(list.get(0)));

    print((str)(list.pop()));
    print((str)(list.len()));

    list.clear();
    print((str)(list.len()));

    return 0;
}
