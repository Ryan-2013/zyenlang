import <std/test>;

struct OwnedCar {
    let *this.value: ptr<int> = 0;

    fn read() -> int {
        return *this.value;
    }
}

struct OwnedChain {
    let *this.value: ptr<ptr<int>> = 7;
}

fn make_car(value: int) -> OwnedCar {
    let car: OwnedCar = OwnedCar{};
    set *car.value = value;
    return car;
}

fn main() -> int {
    let t: TestStats = test.new_stats("owned struct pointer fields");

    let car: OwnedCar = OwnedCar{};
    t.eq_int("default allocates pointee", *car.value, 0);
    set *car.value = 10;
    t.eq_int("postfix field binds before dereference", *car.value, 10);

    let *car_ptr: ptr<OwnedCar> = OwnedCar{};
    set *((*car_ptr).value) = 20;
    t.eq_int("parenthesized pointer receiver", *((*car_ptr).value), 20);
    t.eq_int("method on dereferenced receiver", (*car_ptr).read(), 20);

    let returned: OwnedCar = make_car(42);
    t.eq_int("returned struct retains owned field", *returned.value, 42);

    let chain: OwnedChain = OwnedChain{};
    t.eq_int("nested owned field allocates every layer", **chain.value, 7);
    return t.summary();
}
