import <std/test>;
import <std/mem>;

fn main() -> int {
    let t: TestStats = test.new_stats("ptr void and nested casts");
    let value: ptr<int> = mem.alloc_int(10);
    let opaque: ptr<void> = value;
    let typed: ptr<int> = (ptr<int>)opaque;
    t.eq_int("void ptr cast", *typed, 10);

    let stack_value: int = 12;
    let borrowed_opaque: ptr<void> = &stack_value;
    let borrowed_typed: ptr<int> = (ptr<int>)borrowed_opaque;
    t.eq_int("borrowed stack ptr cast", *borrowed_typed, 12);

    let *text: ptr<str> = "hello";
    let erased_text: ptr<void> = text;
    t.eq_str("str cell erased cast", *((ptr<str>)erased_text), "hello");

    let *slot: ptr<ptr<int>> = value;
    let erased_slot: ptr<void> = slot;
    let replacement: ptr<int> = mem.alloc_int(42);
    set *((ptr<ptr<int>>)erased_slot) = replacement;
    let loaded: ptr<int> = *((ptr<ptr<int>>)erased_slot);
    t.eq_int("nested ptr write", *loaded, 42);
    return t.summary();
}
