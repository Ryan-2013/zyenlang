import <std/string>;

fn main() -> int {
    let s: str = "  Zyen Lang  ";
    print((str)(string.trim(s)));
    print((str)(string.lower("ABC")));
    print((str)(string.upper("abc")));
    print((str)(string.repeat("ha", 3)));
    print((str)(string.replace("a-b-c", "-", ":")));
    print((str)(string.reverse("abc")));
    return 0;
}
