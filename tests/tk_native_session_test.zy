import <std/tk>;

fn main() -> int {
    let code: int = tk.session_open("Zyen native tk smoke", 320, 180, "tk_native_session_smoke");
    if (code != 0) {
        return code;
    }
    tk.session_begin_frame();
    tk.bg("#202124");
    tk.rect(24, 24, 120, 56, "#3aa0ff");
    tk.text(36, 42, "native tk", "#ffffff", 16);
    tk.session_redraw();
    tk.session_next_event(80);
    tk.session_close();
    return 0;
}
