fn main() -> int {
    let xs = [1, "hi", true];

    print((str)(xs.get(0)));
    print((str)(xs.get(1)));
    print((str)(xs.get(2)));

    xs.set(0, "changed");
    xs.append(3.14);

    print((str)(xs.get(0)));
    print((str)(xs.get(3)));

    let p: ptr = xs.ptr(0);
    set *p = 99;
    print((str)(xs.get(0)));

    return 0;
}
