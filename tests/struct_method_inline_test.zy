// Test struct-body method definitions (ZEP-0011).
// In v0.1.49 methods are defined inside the struct body. This test
// exercises multiple inline methods per struct, methods that mutate
// `this`, methods that read fn-typed `this` fields, and method-to-method
// calls within the same struct.

struct TStats {
    let this.pass: int;
    let this.fail: int;
    fn check(cond: bool, msg: str) -> int {
        if (cond) {
            set this.pass += 1;
        } else {
            set this.fail += 1;
            print(msg);
        }
        return 0;
    }
    fn total() -> int {
        return this.pass + this.fail;
    }
    fn report(name: str) -> int {
        print(name);
        print(this.pass);
        print(this.fail);
        return 0;
    }
}

// fn-typed struct field accessed through an inline method.
fn add(a: int, b: int) -> int {
    return a + b;
}

fn mul(a: int, b: int) -> int {
    return a * b;
}

struct Combiner {
    let this.op: fn(int,int)->int;
    let this.seed: int;
    fn fold(x: int, y: int) -> int {
        return this.op(this.op(this.seed, x), y);
    }
}

fn main() -> int {
    let t: TStats = TStats { pass: 0, fail: 0 };

    // Inline method on TStats
    t.check(1 + 1 == 2, "1+1 should be 2");
    t.check(2 * 3 == 6, "2*3 should be 6");
    t.check(10 - 4 == 6, "10-4 should be 6");

    // Method reading inline-mutated state from a sibling method.
    let total: int = t.total();
    t.check(total == 3, "total should be 3");

    // Inline method on Combiner reading fn-typed field.
    let ca: Combiner = Combiner { op: add, seed: 10 };
    t.check(ca.fold(2, 3) == 15, "add fold should be 15");

    let cm: Combiner = Combiner { op: mul, seed: 2 };
    t.check(cm.fold(3, 4) == 24, "mul fold should be 24");

    t.report("struct_method_inline");
    return 0;
}
