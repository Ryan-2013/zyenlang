// c_module.Module and c_module.load are compiler intrinsics. A load must
// directly initialize a field or local dependent type:
//   let math: c_module.Module = c_module.load("native_math.zlcm.h");
// The compiler expands a hidden typed wrapper and links the declared C files.
// Templates may expose ZL_List, ZL_ptr<T>, fn(...) -> T callbacks, and
// ZLC_STRUCT value types through the stable zyenlang_c_abi.h ABI v3 boundary.
// No generated .zy file, command, or Python process is used.

fn enabled() -> bool {
    return true;
}
