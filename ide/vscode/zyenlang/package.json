{
  "name": "zyenlang",
  "displayName": "ZyenLang",
  "description": "Project-aware language support for ZyenLang: completion, navigation, refactoring, diagnostics, run, build, and test.",
  "version": "0.3.2",
  "publisher": "zyenlang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ryan-2013/zyenlang.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Themes"
  ],
  "activationEvents": [
    "onLanguage:zyen",
    "onCommand:zyenlang.check",
    "onCommand:zyenlang.run",
    "onCommand:zyenlang.build",
    "onCommand:zyenlang.emitC",
    "onCommand:zyenlang.test",
    "onCommand:zyenlang.clean",
    "onCommand:zyenlang.refreshIndex"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Editing and highlighting remain available. Compiler execution, diagnostics, Run, and Build require workspace trust.",
      "restrictedConfigurations": [
        "zyenlang.compilerPath"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "zyen",
        "aliases": [
          "ZyenLang",
          "zyen"
        ],
        "extensions": [
          ".zy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zyen",
        "scopeName": "source.zyen",
        "path": "./syntaxes/zyen.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zyen",
        "path": "./snippets/zyen.code-snippets"
      }
    ],
    "themes": [
      {
        "label": "ZyenLang Ember",
        "uiTheme": "vs-dark",
        "path": "./themes/ZyenLang Ember-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "zyenlang.check",
        "title": "ZyenLang: Check Current File",
        "icon": "$(check)"
      },
      {
        "command": "zyenlang.run",
        "title": "ZyenLang: Run Project Target",
        "icon": "$(play)"
      },
      {
        "command": "zyenlang.build",
        "title": "ZyenLang: Build Project Target",
        "icon": "$(tools)"
      },
      {
        "command": "zyenlang.emitC",
        "title": "ZyenLang: Emit C Source"
      },
      {
        "command": "zyenlang.test",
        "title": "ZyenLang: Test Project",
        "icon": "$(beaker)"
      },
      {
        "command": "zyenlang.clean",
        "title": "ZyenLang: Clean Project Target"
      },
      {
        "command": "zyenlang.refreshIndex",
        "title": "ZyenLang: Refresh Project Index",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "zyenlang.run",
          "when": "editorLangId == zyen",
          "group": "navigation@1"
        },
        {
          "command": "zyenlang.check",
          "when": "editorLangId == zyen",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "ZyenLang",
      "properties": {
        "zyenlang.compilerPath": {
          "type": "string",
          "default": "zy",
          "description": "Path to the ZyenLang compiler executable."
        },
        "zyenlang.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Check ZyenLang files as you edit."
        },
        "zyenlang.diagnostics.delay": {
          "type": "number",
          "default": 300,
          "minimum": 100,
          "maximum": 5000,
          "description": "Milliseconds to wait after editing before checking."
        },
        "zyenlang.diagnostics.timeout": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "maximum": 120000,
          "description": "Maximum time in milliseconds for one live compiler check."
        },
        "zyenlang.diagnostics.maxFileSizeKb": {
          "type": "number",
          "default": 1024,
          "minimum": 64,
          "maximum": 16384,
          "description": "Maximum document size checked automatically, in KiB."
        },
        "zyenlang.build.release": {
          "type": "boolean",
          "default": true,
          "description": "Use release mode for Run and Build commands."
        },
        "zyenlang.project.target": {
          "type": "string",
          "default": "",
          "description": "Preferred project target. Leave empty to use build.default-target or choose when a project has multiple targets."
        },
        "zyenlang.run.arguments": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Arguments passed to the ZyenLang program after `zy run --`."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "zyenlang",
        "owner": "zyenlang",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+):\\s*(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ]
  },
  "scripts": {
    "test": "node test/language.test.js && node test/project.test.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
