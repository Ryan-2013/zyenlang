import <std/string>;
import <std/char>;

fn main() -> int {
    print((str)(string.len("Zyen")));
    print((str)(string.eq("abc", "abc")));
    print((str)(string.starts_with("ZyenLang", "Zyen")));
    print((str)(string.ends_with("ZyenLang", "Lang")));
    print((str)(string.index_of("ZyenLang", "Lang")));
    print((str)(string.count_char("banana", 97)));
    print((str)(char.to_upper(122)));

    return 0;
}
