private native fn draw_code_editor_native(x: i32, y: i32, width: i32, height: i32, first_line: i32, line_height: i32, char_width: i32, size: i32, stamp: i32, lines: str, selection_start_line: i32, selection_start_column: i32, selection_end_line: i32, selection_end_column: i32) i32 = "zl_tk_codeview_editor_text"
