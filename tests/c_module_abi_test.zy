import <std/test>;
import <std/c_module> as c_module;

fn main() -> int {
    let t: TestStats = test.new_stats("c_module ABI types");
    let native: c_module.Module = c_module.load("native_abi.zlcm.h");
    let values: List = [10, 20, 12];
    t.eq_int("ZL_List parameter", native.list_len(values), 3);
    let made: List = native.make_list();
    t.eq_int("ZL_List return length", made.len(), 2);
    t.eq_int("ZL_Value item", (int)made.get(1), 22);
    let value_ptr: ptr<int> = native.make_ptr(42);
    t.eq_int("ZL_ptr round trip", native.read_ptr(value_ptr), 42);
    let point: NativePoint = NativePoint { x: 10.0, y: 20.0 };
    let moved: NativePoint = native.move_point(point, 2.5, -5.0);
    t.eq_float("C struct x", moved.x, 12.5, 0.0001);
    t.eq_float("C struct y", moved.y, 15.0, 0.0001);
    return t.summary();
}
