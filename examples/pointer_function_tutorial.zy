fn add(a: int, b: int) -> int {
    return a + b;
}

fn sub(a: int, b: int) -> int {
    return a - b;
}

fn apply(op: fn(int,int)->int, a: int, b: int) -> int {
    return op(a, b);
}

fn pick(name: str) -> fn(int,int)->int {
    if (name == "add") {
        return add;
    }
    return sub;
}

struct ScoreBox {
    let this.value: ptr<int>;
}

fn make_score() -> ScoreBox {
    let *score: ptr<int> = 110;
    let box: ScoreBox = ScoreBox { value: score };
    return box;
}

fn main() -> int {
    let *deep: ptr<ptr<int>> = 10;
    print((str)(**deep));

    let *slot: ptr<ptr> = &**deep;
    set **slot = 21;
    print((str)(**deep));

    let box: ScoreBox = make_score();
    print((str)(*box.value));

    let op: fn(int,int)->int = pick("sub");
    print((str)(apply(op, 10, 3)));
    print((str)pick("add")(20, 22));

    let func_ptr: ptr<fn(int,int)->int> = &add;
    print(f"{(*func_ptr)(20, 22)}");
    let opaque: ptr<void> = func_ptr;
    print(f"{(*(ptr<fn(int,int)->int>)opaque)(12, 10)}");

    let *owned_func_ptr: ptr<fn(int,int)->int> = op;
    print(f"{(*owned_func_ptr)(10, 3)}");
    return 0;
}
