fn main() -> int {
    let i: int = 12;
    let s: str = (str)i;
    print((str)(s));

    let t: str = "34";
    let n: int = (int)t;
    print((str)(n + 1));

    let f: float = (float)i;
    print((str)(f));

    let b: bool = (bool)i;
    print((str)(b));

    let list: List = List;
    list.append(123);
    let x: str = (str)list.get(0);
    print((str)(x));

    return 0;
}
