fn main() -> int {
    let a: ptr<int>;
    print((str)(a));

    let value: int = 10;
    set a = &value;
    print((str)(*a));

    set *a = 20;
    print((str)(value));

    set a = None;
    print((str)(a));

    let *b: ptr<int> = 1;
    print((str)(*b));
    set *b = 2;
    print((str)(*b));

    let *c: ptr<int>;
    print((str)(c));

    return 0;
}
