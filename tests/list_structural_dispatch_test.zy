import <std/test>;

struct DispatchDog {
    let this.base: int;

    fn bark() -> void {
        print("dog");
    }

    fn score(delta: int) -> int {
        return this.base + delta;
    }
}

struct DispatchCat {
    let this.base: int;

    fn bark() -> void {
        print("cat");
    }

    fn score(delta: int) -> int {
        return this.base + delta;
    }
}

struct DispatchPointerDog {
    let this.value: ptr<int>;

    fn read() -> int {
        return *this.value;
    }
}

struct DispatchPointerCat {
    let this.value: ptr<int>;

    fn read() -> int {
        return *this.value;
    }
}

fn make_dispatch_animals() -> List {
    let values: List = [DispatchDog { base: 40 }, DispatchCat { base: 39 }];
    return values;
}

fn main() -> int {
    let t: TestStats = test.new_stats("List structural dispatch");
    let animals: List = [DispatchDog { base: 40 }, DispatchCat { base: 39 }];
    animals.get(0).bark();
    animals.get(1).bark();
    t.eq_int("literal dog dispatch", animals.get(0).score(2), 42);
    t.eq_int("literal cat dispatch", animals.get(1).score(3), 42);

    let appended: List = [];
    appended.append(DispatchDog { base: 41 });
    appended.append(DispatchCat { base: 40 });
    t.eq_int("append dispatch", appended.get(0).score(1), 42);
    let popped: DispatchCat = (DispatchCat)appended.pop();
    t.eq_int("pop transfers boxed struct", popped.score(2), 42);

    let *owned_value: ptr<int> = 42;
    let managed: List = [DispatchPointerDog { value: owned_value }, DispatchPointerCat { value: owned_value }];
    t.eq_int("boxed struct retains managed field", managed.get(1).read(), 42);

    let erased: List = make_dispatch_animals();
    t.eq_int("returned List uses checked dispatch", erased.get(1).score(3), 42);

    animals.clear();
    appended.clear();
    managed.clear();
    erased.clear();
    return t.summary();
}
