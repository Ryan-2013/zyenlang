import <std/test>;

// ZEP-0010: first-class fn values — tests for the four supported uses.

fn add(a: int, b: int) -> int {
    return a + b;
}

fn mul(a: int, b: int) -> int {
    return a * b;
}

fn neg(a: int) -> int {
    return 0 - a;
}

// (1) fn type as a parameter type.
fn combine(op: fn(int,int)->int, x: int, y: int) -> int {
    return op(x, y);
}

// (2) fn type as a return type.
fn pick_op(name: str) -> fn(int,int)->int {
    if (name == "add") {
        return add;
    }
    return mul;
}

// (3) fn-typed field in a struct (closure replacement).
struct Mapper {
    let this.f: fn(int)->int;

    fn apply(x: int) -> int {
        return this.f(x);
    }
}

fn main() -> int {
    let t: TestStats = test.new_stats("ZEP-0010 fn values");

    // pass fn as parameter
    t.eq_int("combine(add,3,4)", combine(add, 3, 4), 7);
    t.eq_int("combine(mul,3,4)", combine(mul, 3, 4), 12);

    // store and call through fn-typed variable
    let f: fn(int,int)->int = add;
    t.eq_int("var add via fn-ptr", f(10, 5), 15);

    // return fn from function
    let chosen: fn(int,int)->int = pick_op("mul");
    t.eq_int("pick_op returns mul", chosen(6, 7), 42);
    let chosen2: fn(int,int)->int = pick_op("add");
    t.eq_int("pick_op returns add", chosen2(6, 7), 13);

    // struct field of fn type
    let m: Mapper = Mapper { f: neg };
    t.eq_int("Mapper.apply(neg, 5)", m.apply(5), -5);

    // bare uninitialized fn-typed local defaults to NULL — must NOT crash
    // when re-assigned and then called.
    let g: fn(int,int)->int;
    set g = mul;
    t.eq_int("uninitialized then set", g(4, 5), 20);

    return t.summary();
}
