import <std/mem>;

fn main() -> int {
    let p: ptr<int> = mem.alloc_int(10);

    print((str)(*p));

    set *p = 55;
    print((str)(*p));

    print((str)(mem.is_valid(p)));
    print((str)(mem.is_owned(p)));
    print((str)(mem.type_name(p)));

    let code: int = mem.free(p);
    print((str)(code));
    print((str)(mem.is_valid(p)));
    print((str)(p));

    return 0;
}
