import std::gui as gui
import std::thread as thread

fn main() i32 {
    let app = gui::application("ZyenLang 0.3", 800, 480)
    if app.open() != 0 {
        return 1
    }
    let running: bool = true
    let frames: i32 = 0
    while running {
        if app.begin_frame() != 0 {
            break
        }
        app.text(40, 40, "Hello from ZyenLang 0.3", "#ffffff", 28)
        app.rect(40, 96, 240, 80, "#2f6fed")
        if app.present() != 0 {
            break
        }
        let event: str = app.next_event(0)
        if event == "quit" {
            running = false
        }
        frames = frames + 1
        if frames >= 90 {
            break
        }
        thread::sleep_ms(16)
    }
    return app.close()
}
