import <std/test>;
import <std/request>;
import <std/string>;
import <std/fs>;

fn main() -> int {
    let t: TestStats = test.new_stats("request");
    let base: str = "http://127.0.0.1:18765";

    let got: Response = request.get(base + "/get", 5000);
    t.eq_int("GET status", got.status, 200);
    t.eq_bool("GET ok", got.ok(), true);
    t.eq_bool("GET body", string.contains(got.body, "hello from request fixture"), true);

    let posted: Response = request.post(base + "/post", "hello", "text/plain", 5000);
    t.eq_int("POST status", posted.status, 201);
    t.eq_bool("POST body", string.contains(posted.body, "post:hello"), true);

    let removed: Response = request.delete(base + "/item", 5000);
    t.eq_int("DELETE status", removed.status, 204);
    t.eq_bool("DELETE ok", removed.ok(), true);

    let saved: Response = request.download(base + "/download", "tests/_request_download.bin", 5000);
    t.eq_bool("download ok", saved.ok(), true);
    t.eq_bool("download file exists", fs.exists("tests/_request_download.bin"), true);
    return t.summary();
}
