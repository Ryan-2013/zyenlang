import <std/test>;

fn add3(a: int, b: int) -> int {
    return a + b;
}

fn add2() -> fn(int,int)->int {
    return add3;
}

fn add1() -> fn()->fn(int,int)->int {
    return add2;
}

fn answer() -> int {
    return 42;
}

fn get_add_pointer() -> ptr<fn(int,int)->int> {
    return &add3;
}

fn invoke_pointer(operation: ptr<fn(int,int)->int>, a: int, b: int) -> int {
    return *operation(a, b);
}

fn make_adder(delta: int) -> fn(int)->int {
    fn add_delta(value: int) -> int {
        return value + delta;
    }
    return add_delta;
}

struct FunctionCell {
    let this.operation: ptr<fn(int,int)->int>;

    fn call(a: int, b: int) -> int {
        return *this.operation(a, b);
    }
}

fn main() -> int {
    let t: TestStats = test.new_stats("function pointers");

    let stage2: fn()->fn(int,int)->int = add1();
    let stage3: fn(int,int)->int = stage2();
    t.eq_int("multi-level fn factory", stage3(10, 10), 20);

    let func_ptr: ptr<fn(int,int)->int> = &add3;
    t.eq_int("parenthesized pointer call", (*func_ptr)(20, 22), 42);
    t.eq_int("short pointer call", *func_ptr(19, 23), 42);
    *func_ptr(1, 2);

    let answer_ptr: ptr<fn()->int> = &answer;
    t.eq_int("zero-argument short call", *answer_ptr(), 42);
    let returned_ptr: ptr<fn(int,int)->int> = get_add_pointer();
    t.eq_int("returned static function pointer", *returned_ptr(17, 25), 42);
    t.eq_int("function pointer parameter", invoke_pointer(returned_ptr, 16, 26), 42);

    let erased: ptr<void> = func_ptr;
    t.eq_int("void erased pointer call", *(ptr<fn(int,int)->int>)erased(12, 10), 22);

    let *owned_ptr: ptr<fn(int,int)->int> = add3;
    t.eq_int("owned function cell", *owned_ptr(21, 21), 42);

    let add5: fn(int)->int = make_adder(5);
    let *closure_ptr: ptr<fn(int)->int> = add5;
    t.eq_int("owned closure cell", *closure_ptr(37), 42);

    let escaped_closure_ptr: ptr<fn(int)->int> = None;
    if (true) {
        let add10: fn(int)->int = make_adder(10);
        let *inner_ptr: ptr<fn(int)->int> = add10;
        set escaped_closure_ptr = inner_ptr;
    }
    t.eq_int("closure cell survives source scope", *escaped_closure_ptr(32), 42);

    let cell: FunctionCell = FunctionCell { operation: func_ptr };
    t.eq_int("struct function pointer field", cell.call(18, 24), 42);
    return t.summary();
}
