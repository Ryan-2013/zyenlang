public fn read_text(path: str) str throws Error {
    let value: str = read_text_native(path)
    let message: str = last_error_native()
    if message != "" {
        stop message
    }
    return value
}

public fn write_text(path: str, value: str) i32 throws Error {
    let status: i32 = write_text_native(path, value)
    if status != 0 {
        stop last_error_native()
    }
    return status
}

public fn append_text(path: str, value: str) i32 throws Error {
    let status: i32 = append_text_native(path, value)
    if status != 0 {
        stop last_error_native()
    }
    return status
}

