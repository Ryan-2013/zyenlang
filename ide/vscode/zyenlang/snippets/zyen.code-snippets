{
  "Main function": {
    "prefix": "main",
    "body": ["fn main() i32 {", "    $0", "    return 0", "}"],
    "description": "ZyenLang program entry point"
  },
  "Function": {
    "prefix": "fn",
    "body": ["${1:public }fn ${2:name}(${3}) ${4:void} {", "    $0", "}"],
    "description": "Declare a function"
  },
  "Throwing function": {
    "prefix": "fnthrows",
    "body": ["${1:public }fn ${2:name}(${3}) ${4:void} throws Error {", "    $0", "}"],
    "description": "Declare a function that can stop with Error"
  },
  "Receiver method": {
    "prefix": "method",
    "body": ["${1:public }fn (${2:self}: ${3:Type}) ${4:name}(${5}) ${6:void} {", "    $0", "}"],
    "description": "Declare a method with an explicit receiver"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["${1:public }struct ${2:Name} {", "    public ${3:value}: ${4:i32}${5: = 0}", "    $0", "}"],
    "description": "Declare a struct"
  },
  "Typed variable": {
    "prefix": "let",
    "body": "let ${1:name}: ${2:i32} = ${3:0}",
    "description": "Declare a typed variable"
  },
  "Inferred variable": {
    "prefix": "leti",
    "body": "let ${1:name} = ${2:value}",
    "description": "Declare an inferred variable"
  },
  "Tuple result": {
    "prefix": "lettuple",
    "body": "let (${1:value}: ${2:i32}, ${3:text}: ${4:str}) = ${5:call}()",
    "description": "Destructure multiple return values"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "    $0", "}"],
    "description": "If statement"
  },
  "If let": {
    "prefix": "iflet",
    "body": ["if let ${1:value} = ${2:optional} {", "    $0", "}"],
    "description": "Unwrap a nullable value"
  },
  "While": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "    $0", "}"],
    "description": "While loop"
  },
  "Catch and recover": {
    "prefix": "catch",
    "body": ["${1:call}() catch ${2:err} {", "    ${3:io.print(${2:err}.message)}", "    recover ${4:value}", "}"],
    "description": "Handle Error and recover a value"
  },
  "Import standard module": {
    "prefix": "importstd",
    "body": "import <std/${1:io}> as ${2:${1}}",
    "description": "Import a standard library module"
  },
  "Spawn task": {
    "prefix": "spawn",
    "body": "let ${1:task}: Task<${2:i32}> = spawn ${3:work}()",
    "description": "Run a zero-argument call concurrently"
  },
  "Await task": {
    "prefix": "await",
    "body": "let ${1:value}: ${2:i32} = await ${3:task}",
    "description": "Wait for a task result"
  },
  "Type check": {
    "prefix": "TYPEOF__",
    "body": "TYPEOF__(${1:value}, ${2:i32})",
    "description": "Test a value's static type"
  },
  "Interpolated string": {
    "prefix": "fstr",
    "body": "f\"${1:label}={${2:value}}\"",
    "description": "Format typed values in a string"
  },
  "List length": {
    "prefix": "LIST_LEN__",
    "body": "LIST_LEN__(${1:list})",
    "description": "Read a built-in List length"
  },
  "List push": {
    "prefix": "LIST_PUSH__",
    "body": "LIST_PUSH__(${1:list}, ${2:value})",
    "description": "Append a strongly typed List value"
  },
  "List set": {
    "prefix": "LIST_SET__",
    "body": ["LIST_SET__(${1:list}, ${2:index}, ${3:value}) catch ${4:err} {", "    recover", "}"],
    "description": "Replace a checked List element"
  },
  "Colored terminal output": {
    "prefix": "PRINT_CMD__",
    "body": "PRINT_CMD__(${1:text}, \"${2:#FFFFFF}\")",
    "description": "Print one line with a terminal color"
  },
  "String characters": {
    "prefix": "STR_TO_LIST__",
    "body": "let ${1:chars}: List<str> = STR_TO_LIST__(${2:text})",
    "description": "Split UTF-8 text into a List of characters"
  },
  "End local lifetime": {
    "prefix": "FREE__",
    "body": "FREE__(${1:local})",
    "description": "End a local binding and release managed storage"
  },
  "Promote local one block": {
    "prefix": "SKIP__",
    "body": "SKIP__(${1:local})",
    "description": "Keep a local visible after its current block"
  },
  "HTTP GET": {
    "prefix": "requestget",
    "body": ["import <std/request> as request", "", "let response: request.Response = request.get(\"${1:https://example.com}\")", "if response.ok() {", "    ${0}", "}"],
    "description": "Make an HTTP GET request"
  },
  "GUI frame loop": {
    "prefix": "gui",
    "body": ["import <std/gui> as gui", "", "let app = gui.application_colored(\"${1:ZyenLang}\", ${2:960}, ${3:640}, \"#20201F\")", "app.open()", "while true {", "    app.begin_frame()", "    ${0}", "    app.present()", "    if app.next_event(16) == \"quit\" {", "        break", "    }", "}", "app.close()"],
    "description": "Create a cross-platform GUI application loop"
  }
}
