public class Window {
    public title: str = "ZyenLang"
    public width: i32 = 800
    public height: i32 = 600
    public background: str = "#20201F"
    public fps: i32 = 60

    public init(title: str, width: i32, height: i32, background: str = "#20201F") {
        this.title = title
        this.width = width
        this.height = height
        this.background = background
    }

    public fn open() i32 {
        let result = session_open(this.title, this.width, this.height, "")
        if result == 0 {
            session_set_fps(this.fps)
        }
        return result
    }

    public fn begin_frame() i32 {
        let result = session_begin_frame()
        if result == 0 {
            draw_background(this.background)
        }
        return result
    }

    public fn present() i32 {
        return session_redraw()
    }

    public fn next_event(timeout_ms: i32) str {
        return session_next_event(timeout_ms)
    }

    public fn close() i32 {
        return session_close()
    }
}

public class Application {
    public window: Window

    public init(window: Window) {
        this.window = window
    }

    public fn open() i32 {
        return this.window.open()
    }

    public fn begin_frame() i32 {
        return this.window.begin_frame()
    }

    public fn present() i32 {
        return this.window.present()
    }

    public fn next_event(timeout_ms: i32) str {
        return this.window.next_event(timeout_ms)
    }

    public fn close() i32 {
        return this.window.close()
    }
}

public class Panel {
    public x: i32 = 0
    public y: i32 = 0
    public width: i32 = 320
    public height: i32 = 240
    public background: str = "#292827"
    public border: str = "#494744"

    public init(x: i32, y: i32, width: i32, height: i32) {
        this.x = x
        this.y = y
        this.width = width
        this.height = height
    }

    public fn draw() i32 {
        let border_result = rect(this.x, this.y, this.width, this.height, this.border)
        if border_result != 0 {
            return border_result
        }
        return rect(this.x + 1, this.y + 1, this.width - 2, this.height - 2, this.background)
    }
}

public class Label {
    public x: i32 = 0
    public y: i32 = 0
    public value: str = ""
    public color: str = "#F4F1EA"
    public size: i32 = 18

    public init(x: i32, y: i32, value: str) {
        this.x = x
        this.y = y
        this.value = value
    }

    public fn draw() i32 {
        return text(this.x, this.y, this.value, this.color, this.size)
    }
}

public class Button {
    public x: i32 = 0
    public y: i32 = 0
    public width: i32 = 180
    public height: i32 = 44
    public label: str = "Button"
    public background: str = "#D97757"
    public disabled_background: str = "#6E6965"
    public text_color: str = "#20201F"
    public border: str = "#F0A084"
    public font_size: i32 = 18
    public enabled: bool = true
    public on_click: fn() void

    public init(x: i32, y: i32, width: i32, height: i32, label: str, on_click: fn() void) {
        this.x = x
        this.y = y
        this.width = width
        this.height = height
        this.label = label
        this.on_click = on_click
    }

    public fn contains(x: i32, y: i32) bool {
        return x >= this.x && x < this.x + this.width && y >= this.y && y < this.y + this.height
    }

    public fn draw() i32 {
        let fill = this.background
        if !this.enabled {
            fill = this.disabled_background
        }
        let border_result = rect(this.x, this.y, this.width, this.height, this.border)
        if border_result != 0 {
            return border_result
        }
        let fill_result = rect(this.x + 1, this.y + 1, this.width - 2, this.height - 2, fill)
        if fill_result != 0 {
            return fill_result
        }
        return text(this.x + 14, this.y + (this.height - this.font_size) / 2, this.label, this.text_color, this.font_size)
    }

    public fn handle(event: str) bool {
        if this.enabled && event_kind(event) == 2 && this.contains(event_x(event), event_y(event)) {
            this.on_click()
            return true
        }
        return false
    }
}

public class ButtonGroup {
    public buttons: List<Button> = []

    public init() {
    }

    public mut fn add(button_value: Button) void {
        LIST_PUSH__(this.buttons, button_value)
    }

    public fn draw() i32 throws Error {
        let index: i32 = 0
        while index < (i32)LIST_LEN__(this.buttons) {
            let button_value = LIST_GET__(this.buttons, index)
            let result = button_value.draw()
            if result != 0 {
                return result
            }
            index += 1
        }
        return 0
    }

    public fn handle(event: str) bool throws Error {
        let index: i32 = 0
        let handled = false
        while index < (i32)LIST_LEN__(this.buttons) {
            let button_value = LIST_GET__(this.buttons, index)
            if button_value.handle(event) {
                handled = true
            }
            index += 1
        }
        return handled
    }
}

public class Column {
    public x: i32 = 0
    public y: i32 = 0
    public width: i32 = 240
    public row_height: i32 = 44
    public gap: i32 = 10

    public init(x: i32, y: i32, width: i32, row_height: i32, gap: i32) {
        this.x = x
        this.y = y
        this.width = width
        this.row_height = row_height
        this.gap = gap
    }

    public fn item_y(index: i32) i32 {
        return this.y + index * (this.row_height + this.gap)
    }

    public fn button_at(index: i32, label_value: str, on_click: fn() void) Button {
        return button(this.x, this.item_y(index), this.width, this.row_height, label_value, on_click)
    }

    public fn label_at(index: i32, value: str) Label {
        return label(this.x, this.item_y(index) + (this.row_height - 18) / 2, value)
    }
}

